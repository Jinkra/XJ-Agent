{
  "name": "jinkra-companion",
  "version": "0.2.2",
  "description": "小金同学 · AI 编程桌面伙伴",
  "main": "src/main.cjs",
  "author": "Jinkra",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/electron-smoke.cjs",
    "pack": "node scripts/package.cjs",
    "dist": "node scripts/prepare-updater.cjs && node scripts/build-installer.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "playwright": "1.65.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331",
    "lucide": "^1.77.0"
  },
  "productName": "小金同学",
  "build": {
    "appId": "com.jinkra.companion",
    "productName": "小金同学",
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/release/*.cs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/ui/brand/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/updater/xj-agent-updater.exe",
        "to": "xj-agent-updater.exe"
      },
      {
        "from": "vendor/updater/xj-agent-uninstall-ui.exe",
        "to": "xj-agent-uninstall-ui.exe"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小金同学",
      "include": "scripts/installer-shortcuts.nsh"
    },
    "win": {
      "icon": "src/ui/brand/icon.ico",
      "signExecutable": false,
      "executableName": "小金同学",
      "artifactName": "XJ-Agent-Payload-${version}-${arch}.${ext}"
    }
  }
}
